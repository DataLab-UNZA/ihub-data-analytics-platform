# Copy to .env and fill in locally. NEVER commit .env.
# In GitHub Actions these are set as repository secrets (or variables where marked).

# --- Storage ---
IHUB_DATA_DIR=data
IHUB_DUCKDB_PATH=data/ihub.duckdb

# --- OpenAlex ---
# Contact email for OpenAlex's polite pool (variable, not secret)
OPENALEX_MAILTO=
# OpenAlex API key (secret). Required by OpenAlex since February 13, 2026; free at openalex.org/settings/api
OPENALEX_API_KEY=

# --- ORCID public API (client credentials; secret) ---
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- OJS REST API token (optional; secret) ---
OJS_API_TOKEN=

# --- Deployment ---
# The app is hosted on Streamlit Community Cloud and needs no deployment
# secrets: it only reads public data. The pipeline's API credentials above are
# GitHub repository secrets; OPENALEX_MAILTO is a repository variable.
# See docs/DEPLOYMENT.md.
