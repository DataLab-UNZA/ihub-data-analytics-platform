# Copy to .env and fill in locally. NEVER commit .env.
# In GitHub Actions, secrets live in the "pipeline" environment; non-secret values are repository variables.

# --- Storage ---
# Relative paths are taken from the repository root (by Python and by dbt alike).
IHUB_DATA_DIR=data
IHUB_DUCKDB_PATH=data/ihub.duckdb

# --- OpenAlex ---
# Contact email for OpenAlex's polite pool (variable, not secret)
OPENALEX_MAILTO=
# OpenAlex API key, if one is used (secret)
OPENALEX_API_KEY=

# --- ORCID public API (client credentials; secret) ---
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- OJS REST API token (optional; secret) ---
OJS_API_TOKEN=

# --- Environment ---
# "production" (default, safe) or "development" (allows a temporary auth secret and
# prints email sign-in codes to the console instead of sending them).
IHUB_ENV=development

# --- Authentication (ADR-010; secrets marked) ---
# Research routes need a signed-in user (true, the default); /api/health is always open.
IHUB_REQUIRE_SIGN_IN=true
# At least 32 random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))" (secret)
IHUB_AUTH_SECRET=
# Public address of the web app; Google redirects to <this>/auth/google/callback
IHUB_PUBLIC_URL=http://localhost:3000
# Only addresses at this domain may sign in. * accepts any verified address, including Gmail.
IHUB_ALLOWED_EMAIL_DOMAIN=unza.ac.zm
# Comma-separated emails that are always made administrators
IHUB_BOOTSTRAP_ADMINS=
# Local user store (SQLite). Production needs persistent storage by default.
IHUB_AUTH_DB_PATH=data/auth.sqlite
# Set true only to demo accounts from Cloud Run's temporary /tmp disk. Accounts disappear
# after a restart, scale-to-zero event, or deployment.
IHUB_ALLOW_EPHEMERAL_AUTH=false
# Saved charts and dashboards (SQLite for development; production needs ADR-009's store)
IHUB_WORKSPACE_DB_PATH=data/workspace.sqlite
# Google OAuth client (Google Cloud console > APIs & Services > Credentials; secret)
IHUB_GOOGLE_CLIENT_ID=
IHUB_GOOGLE_CLIENT_SECRET=
# Outgoing mail (ihub.mail). Empty: smtp when IHUB_SMTP_HOST is set, else console in
# development. Other providers plug in with ihub.mail.register_transport.
IHUB_MAIL_TRANSPORT=
# SMTP mailbox that sends email sign-in codes (password is secret; for Gmail use an
# app password). Test with: uv run python -m ihub.mail --to you@example.org
IHUB_SMTP_HOST=
IHUB_SMTP_PORT=587
IHUB_SMTP_USERNAME=
IHUB_SMTP_PASSWORD=
IHUB_SMTP_FROM=
# true for implicit TLS (port 465); false uses STARTTLS
IHUB_SMTP_SSL=false

# --- Deployment (GitHub repository variables, not secrets; local use is optional) ---
# Printed by scripts/gcp_setup.sh. See docs/DEPLOYMENT.md.
GCP_PROJECT_ID=
GCP_REGION=
GCP_WIF_PROVIDER=
GCP_DEPLOY_SA=
GCP_RUNTIME_SA=

# --- Web front end (web/) ---
# Address of the research API (uv run uvicorn ihub.api.app:app --port 8000). Read on the server only.
IHUB_API_URL=http://127.0.0.1:8000
# Show the design-only screens (mock sign-in, screen index). Defaults to true for
# `npm run dev` and false in production builds; never set it to true in production.
IHUB_SHOW_PREVIEWS=
