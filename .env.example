# Copy to .env and fill in locally. NEVER commit .env.
# In GitHub Actions these are set as repository secrets (or variables where marked).

# --- Storage ---
IHUB_DATA_DIR=data
IHUB_DUCKDB_PATH=data/ihub.duckdb

# --- OpenAlex ---
# Contact email for OpenAlex's polite pool (variable, not secret)
OPENALEX_MAILTO=
# OpenAlex API key, if one is used (secret)
OPENALEX_API_KEY=

# --- ORCID public API (client credentials; secret) ---
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- OJS REST API token (optional; secret) ---
OJS_API_TOKEN=

# --- Google Cloud deployment (repository variables, not secrets; keyless auth via Workload Identity Federation) ---
GCP_PROJECT_ID=
GCP_REGION=
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=
