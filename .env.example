# Copy to .env and fill in locally. NEVER commit .env.
# In GitHub Actions, secrets live in the "pipeline" environment; non-secret values are repository variables.

# --- Storage ---
IHUB_DATA_DIR=data
IHUB_DUCKDB_PATH=data/ihub.duckdb

# --- OpenAlex ---
# Contact email for OpenAlex's polite pool (variable, not secret)
OPENALEX_MAILTO=
# OpenAlex API key, if one is used (secret)
OPENALEX_API_KEY=

# --- ORCID public API (client credentials; secret) ---
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- OJS REST API token (optional; secret) ---
OJS_API_TOKEN=

# --- Deployment (GitHub repository variables, not secrets; local use is optional) ---
# Printed by scripts/gcp_setup.sh. See docs/DEPLOYMENT.md.
GCP_PROJECT_ID=
GCP_REGION=
GCP_WIF_PROVIDER=
GCP_DEPLOY_SA=
GCP_RUNTIME_SA=
